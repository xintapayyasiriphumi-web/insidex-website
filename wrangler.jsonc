// Cloudflare Worker (static assets only) — serves insidex.online
// Deploy:  npx wrangler@4 deploy        Local:  npx wrangler@4 dev
// Files uploaded are allowlisted in .assetsignore (index.html, css/, js/, assets/).
{
  "name": "insidex-store",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./"
  },

  // Keep the insidex-store.<account>.workers.dev URL — declaring routes turns it off otherwise.
  "workers_dev": true,

  // Custom Domains of this Worker (a domain can belong to one Worker/Pages project at a time).
  // Cloudflare creates their DNS records; a hand-made record on either hostname blocks the attach.
  "routes": [
    { "pattern": "insidex.online", "custom_domain": true },
    { "pattern": "www.insidex.online", "custom_domain": true }
  ]
}
